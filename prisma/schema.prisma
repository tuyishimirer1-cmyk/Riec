generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum JobApplicationStatus {
  NEW
  IN_REVIEW
  SHORTLISTED
  REJECTED
  HIRED
}

enum PurchaseStatus {
  PENDING
  SUCCESS
  FAILED
}

enum ProjectDocumentType {
  PRESENTATION
  PERSPECTIVE
  SITE_PLAN
  ARCHITECTURAL_DRAWINGS
  STRUCTURAL_DRAWINGS
  MEP_DRAWINGS
  GEOTECHNICAL_REPORT
  TOPOGRAPHICAL_SURVEY
  BILL_OF_QUANTITIES
  BUDGET_ESTIMATE
  ENVIRONMENTAL_IMPACT_ASSESSMENT
  CONSTRUCTION_PERMIT
  LAND_TITLE
  SOIL_TEST_REPORT
  MATERIAL_SPECIFICATIONS
  TENDER_DOCUMENT
  CONTRACT_AGREEMENT
  PROJECT_SCHEDULE
  METHOD_STATEMENT
  QUALITY_CONTROL_PLAN
  HEALTH_SAFETY_PLAN
}

enum ProjectType {
  COMPLETED
  PLAN_TO_BUY
}

enum ProjectCategory {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
}

enum Role {
  CLIENT
  COMPANY_WORKER
  ENGINEER
  ADMIN
}

enum PropertyType {
  HOUSE
  APARTMENT
  LAND
  COMMERCIAL
  VILLA
  OTHER
}

enum ListingType {
  FOR_SALE
  FOR_RENT
}

enum PropertyStatus {
  DRAFT
  PENDING_REVIEW
  VERIFIED
  REJECTED
  PUBLISHED
  RESERVED
  SOLD
  RENTED
  ARCHIVED
}

enum PropertyVerificationStatus {
  NOT_VERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum PropertyDocumentType {
  OWNERSHIP_TITLE
  IDENTIFICATION
  TAX_CLEARANCE
  LAND_TITLE
  UPI_CERTIFICATE
  BUILDING_PERMIT
  OTHER
}

enum InquiryStatus {
  NEW
  READ
  RESPONDED
  CLOSED
}

enum ViewingStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

type ServiceTask {
  title       String
  description String
}

model User {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  email        String    @unique
  passwordHash String?
  firebaseUid  String?   
  role         Role      @default(CLIENT)
  profileImg   String?   @default("")
  coverImg     String?   @default("")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  // relations
  projectsOwned  Project[]           @relation("ProjectOwner")
  uploadedAssets ProjectAsset[]      @relation("UploadedAssets")
  assignments    ProjectAssignment[]
  favorites      Favorite[]          @relation("UserFavorites")
  
  // Properties relations
  properties           Property[]            @relation("PropertyOwner")
  propertyFavorites    PropertyFavorite[]    @relation("UserPropertyFavorites")
  propertyInquiries    PropertyInquiry[]     @relation("UserPropertyInquiries")
  propertyViewings     PropertyViewing[]     @relation("UserPropertyViewings")
  verifiedProperties   Property[]            @relation("VerifiedProperties")
}

model Service {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  name                String
  slug                String   @unique
  shortDescription    String
  detailedDescription String?
  order               Int      @default(0)

  // new rich content fields
  title       String  @default("")
  description String  @default("")
  process     String  @default("")
  mainTasks   ServiceTask[]
  isPublished Boolean @default(false)

  // relations
  images   ServiceImage[] @relation("ServiceImages")
  projects ProjectService[] @relation("ServiceProjects")
}

model Project {
  id            String          @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  slug          String          @unique
  description   String
  location      String
  type          ProjectType     @default(COMPLETED)
  category      ProjectCategory @default(RESIDENTIAL)
  featured      Boolean         @default(false)
  purchasable   Boolean         @default(false)
  isPublished   Boolean         @default(true)
  publishedAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  youtubeVideoUrl String?
  basePrice     Float?
  currency      String          @default("USD")

  // relations
  documentTypes ProjectDocumentType[]
  images       ProjectImage[]      @relation("ProjectImages")
  pricingTiers ProjectPriceTier[]  @relation("ProjectTiers")
  assets       ProjectAsset[]      @relation("ProjectAssets")
  purchases    Purchase[]          @relation("ProjectPurchases")
  assignments  ProjectAssignment[]
  services     ProjectService[]    @relation("ProjectServices")
  ownerId      String?             @db.ObjectId
  owner        User?               @relation("ProjectOwner", fields: [ownerId], references: [id])
  favorites    Favorite[]          @relation("ProjectFavorites")
}

model ProjectService {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId String   @db.ObjectId
  serviceId String   @db.ObjectId
  createdAt DateTime @default(now())

  project Project @relation("ProjectServices", fields: [projectId], references: [id])
  service Service @relation("ServiceProjects", fields: [serviceId], references: [id])

  @@index([projectId])
  @@index([serviceId])
  @@unique([projectId, serviceId])
}

model ServiceImage {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  serviceId String  @db.ObjectId
  service   Service @relation("ServiceImages", fields: [serviceId], references: [id])
  s3Key     String
  url       String
  caption   String?
  order     Int     @default(0)

  @@index([serviceId])
}

model ProjectImage {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  projectId String  @db.ObjectId
  project   Project @relation("ProjectImages", fields: [projectId], references: [id])
  s3Key     String
  url       String
  caption   String?
  order     Int     @default(0)

  @@index([projectId])
}

model ProjectPriceTier {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  projectId   String  @db.ObjectId
  project     Project @relation("ProjectTiers", fields: [projectId], references: [id])
  name        String
  description String?
  currency    String
  amount      Float
  isActive    Boolean @default(true)

  // back-relations
  assets    ProjectAsset[] @relation("TierAssets")
  purchases Purchase[]     @relation("TierPurchases")

  @@index([projectId])
}

model ProjectAsset {
  id        String            @id @default(auto()) @map("_id") @db.ObjectId
  projectId String            @db.ObjectId
  project   Project           @relation("ProjectAssets", fields: [projectId], references: [id])
  tierId    String?           @db.ObjectId
  tier      ProjectPriceTier? @relation("TierAssets", fields: [tierId], references: [id])

  documentType ProjectDocumentType
  version      String?

  s3Key          String
  filename       String
  fileType       String
  size           Int
  isDownloadable Boolean @default(true)

  uploadedById String? @db.ObjectId
  uploadedBy   User?   @relation("UploadedAssets", fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([tierId])
}

model ProjectAssignment {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId  String   @db.ObjectId
  project    Project  @relation(fields: [projectId], references: [id])
  userId     String   @db.ObjectId
  user       User     @relation(fields: [userId], references: [id])
  role       String?
  assignedAt DateTime @default(now())

  @@index([projectId])
  @@index([userId])
}

model ContactSubmission {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  phone     String?
  company   String?
  subject   String?
  message   String
  reply     String?
  repliedAt DateTime?
  repliedBy String?
  createdAt DateTime @default(now())
  read      Boolean  @default(false)
}

model Job {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  slug             String   @unique
  title            String
  location         String
  employmentType   String
  department       String
  description      String
  requirements     String
  responsibilities String
  isPublished      Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  applications JobApplication[]
}

model JobApplication {
  id             String               @id @default(auto()) @map("_id") @db.ObjectId
  jobId          String               @db.ObjectId
  job            Job                  @relation(fields: [jobId], references: [id])
  fullName       String
  email          String
  phone          String?
  cvS3Key        String?
  cvUrl          String?
  coverLetter    String?
  qualifications String?
  createdAt      DateTime             @default(now())
  status         JobApplicationStatus @default(NEW)
  notes          String?

  @@index([jobId])
}

model Purchase {
  id             String            @id @default(auto()) @map("_id") @db.ObjectId
  projectId      String            @db.ObjectId
  project        Project           @relation("ProjectPurchases", fields: [projectId], references: [id])
  tierId         String?           @db.ObjectId
  tier           ProjectPriceTier? @relation("TierPurchases", fields: [tierId], references: [id])
  email          String
  fullName       String
  flutterwaveRef String
  amount         Float
  currency       String
  status         PurchaseStatus    @default(PENDING)
  downloadToken  String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([projectId])
  @@index([tierId])
}

model Favorite {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  projectId String   @db.ObjectId
  createdAt DateTime @default(now())

  user    User    @relation("UserFavorites", fields: [userId], references: [id])
  project Project @relation("ProjectFavorites", fields: [projectId], references: [id])

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
}


// ============================================
// PROPERTIES MARKETPLACE MODELS
// ============================================

model Property {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String       @unique
  description String
  
  // Property Type & Listing
  propertyType PropertyType
  listingType  ListingType
  
  // Price
  price        Float
  currency     String       @default("RWF")
  priceNegotiable Boolean   @default(false)
  
  // Location
  district     String
  sector       String
  cell         String
  streetAddress String?
  latitude     Float?
  longitude    Float?
  
  // Property Details
  landSize     Float          // in square meters
  buildingSize Float?         // in square meters (for houses/apartments)
  bedrooms     Int?
  bathrooms    Int?
  parking      Int?           @default(0)
  amenities    String[]       // Array of amenities
  
  // Status & Verification
  status               PropertyStatus               @default(DRAFT)
  verificationStatus   PropertyVerificationStatus   @default(NOT_VERIFIED)
  verifiedAt           DateTime?
  verifiedById         String?                      @db.ObjectId
  verifiedBy           User?                        @relation("VerifiedProperties", fields: [verifiedById], references: [id])
  rejectionReason      String?
  
  // Featured & Availability
  isFeatured    Boolean   @default(false)
  featuredUntil DateTime?
  isAvailable   Boolean   @default(true)
  
  // Seller/Agent Information
  sellerId      String    @db.ObjectId
  seller        User      @relation("PropertyOwner", fields: [sellerId], references: [id])
  sellerPhone   String
  sellerWhatsApp String?
  sellerEmail   String
  
  // SEO & Metadata
  viewCount     Int       @default(0)
  
  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  publishedAt   DateTime?
  
  // Relations
  images       PropertyImage[]      @relation("PropertyImages")
  videos       PropertyVideo[]      @relation("PropertyVideos")
  documents    PropertyDocument[]   @relation("PropertyDocuments")
  favorites    PropertyFavorite[]   @relation("PropertyFavorites")
  inquiries    PropertyInquiry[]    @relation("PropertyInquiries")
  viewings     PropertyViewing[]    @relation("PropertyViewings")
  payments     PropertyPayment[]    @relation("PropertyPayments")
  
  @@index([status])
  @@index([propertyType])
  @@index([listingType])
  @@index([district])
  @@index([sellerId])
  @@index([verificationStatus])
  @@index([isFeatured])
  @@index([createdAt])
}

model PropertyImage {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  propertyId   String   @db.ObjectId
  property     Property @relation("PropertyImages", fields: [propertyId], references: [id], onDelete: Cascade)
  
  cloudinaryId String
  url          String
  thumbnailUrl String?
  caption      String?
  order        Int      @default(0)
  
  createdAt    DateTime @default(now())
  
  @@index([propertyId])
  @@index([order])
}

model PropertyVideo {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  propertyId   String   @db.ObjectId
  property     Property @relation("PropertyVideos", fields: [propertyId], references: [id], onDelete: Cascade)
  
  cloudinaryId String
  url          String
  thumbnailUrl String?
  duration     Int?     // in seconds
  order        Int      @default(0)
  
  createdAt    DateTime @default(now())
  
  @@index([propertyId])
}

model PropertyDocument {
  id           String                @id @default(auto()) @map("_id") @db.ObjectId
  propertyId   String                @db.ObjectId
  property     Property              @relation("PropertyDocuments", fields: [propertyId], references: [id], onDelete: Cascade)
  
  documentType PropertyDocumentType
  cloudinaryId String
  url          String                // Secure URL (private)
  filename     String
  fileSize     Int                   // in bytes
  mimeType     String
  
  createdAt    DateTime              @default(now())
  
  @@index([propertyId])
}

model PropertyFavorite {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  propertyId String   @db.ObjectId
  createdAt  DateTime @default(now())
  
  user       User     @relation("UserPropertyFavorites", fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation("PropertyFavorites", fields: [propertyId], references: [id], onDelete: Cascade)
  
  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
}

model PropertyInquiry {
  id         String        @id @default(auto()) @map("_id") @db.ObjectId
  propertyId String        @db.ObjectId
  property   Property      @relation("PropertyInquiries", fields: [propertyId], references: [id], onDelete: Cascade)
  
  userId     String?       @db.ObjectId
  user       User?         @relation("UserPropertyInquiries", fields: [userId], references: [id])
  
  // Contact Info (for non-registered users)
  name       String
  email      String
  phone      String
  message    String
  
  status     InquiryStatus @default(NEW)
  reply      String?
  repliedAt  DateTime?
  
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  
  @@index([propertyId])
  @@index([userId])
  @@index([status])
}

model PropertyViewing {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  propertyId      String        @db.ObjectId
  property        Property      @relation("PropertyViewings", fields: [propertyId], references: [id], onDelete: Cascade)
  
  userId          String?       @db.ObjectId
  user            User?         @relation("UserPropertyViewings", fields: [userId], references: [id])
  
  // Contact Info
  name            String
  email           String
  phone           String
  preferredDate   DateTime
  preferredTime   String
  message         String?
  
  status          ViewingStatus @default(PENDING)
  adminNotes      String?
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  @@index([propertyId])
  @@index([userId])
  @@index([status])
}

model PropertyPayment {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  propertyId      String         @db.ObjectId
  property        Property       @relation("PropertyPayments", fields: [propertyId], references: [id])
  
  // Payment details
  packageType     String         // "basic_listing", "featured_listing", "verification_fee"
  amount          Float
  currency        String         @default("RWF")
  
  // Payment Gateway (RwandaPay)
  rwandapayRef    String
  status          PurchaseStatus @default(PENDING)
  
  // Customer details
  customerEmail   String
  customerName    String
  customerPhone   String
  
  // Timestamps
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  paidAt          DateTime?
  
  @@index([propertyId])
  @@index([rwandapayRef])
  @@index([status])
}
